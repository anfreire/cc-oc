{
  "description": "On CC session end, prune old opencode session logs (14d / 500MB cap).",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/oc.mjs\" gc",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
